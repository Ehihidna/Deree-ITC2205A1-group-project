# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string. Local example below; on Neon, use the
# connection string from the project dashboard.
DATABASE_URL="postgresql://gym:gym@localhost:5432/gym_tracker"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Gemini API key for the AI agent (Google AI Studio). Server-side only.
GEMINI_API_KEY=""
